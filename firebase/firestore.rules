rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    // TEMPORARY PERMISSIVE RULE FOR DEBUGGING
    // This rule allows authenticated users to read and write any document
    // Remove this after debugging is complete!
    match /{document=**} {
      allow read, write: if isSignedIn();
    }

    // The rules below are ignored while the temporary rule above is active
    // Keep them for reference and restore them after debugging

    // match /users/{userId} {
    //   allow read: if isSignedIn() && request.auth.uid == userId;
    //   allow write: if isSignedIn() && request.auth.uid == userId;
    //   
    //   match /maps/{mapId} {
    //     allow read, write: if isSignedIn() && request.auth.uid == userId;
    //   }
    // }
    
    // match /maps/{mapId} {
    //   allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
    //   allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    //   allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    // }
    
    // match /records/{recordId} {
    //   allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid);
    //   allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    //   allow update, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
    // }
  }
} 
{
  "posture": "assisted",
  "ciCommands": [],
  "bounded": {
    "allowedExactPaths": [
      "README.md"
    ],
    "allowedPathPrefixes": [
      "docs/"
    ],
    "deniedPathFragments": [],
    "defaultBase": "origin/main"
  },
  "branching": {
    "trunk": "main",
    "releaseCandidate": null,
    "integration": "main",
    "directEditDeniedBranches": [
      "main"
    ],
    "defaultPrTarget": "main",
    "promotionOrder": [
      "main"
    ],
    "workBranchPrefixes": [
      "work/",
      "feature/",
      "fix/",
      "hotfix/",
      "spike/",
      "chore/"
    ],
    "compatibilityBranchPrefixes": [
      "issue/",
      "wt/",
      "claude/"
    ],
    "requireBoundedWorkBranch": true
  },
  "integrationLifecycle": {
    "integrationBranch": "main",
    "trunkBranch": "main",
    "referenceKeywords": [
      "Implements",
      "Refs"
    ],
    "addLabels": [
      "integrated:main",
      "awaiting-release"
    ],
    "closeIntegratedIssues": true
  },
  "routing": {
    "defaultMode": "single-agent"
  },
  "collaboration": {
    "defaultMode": "auto-minimal",
    "sensitiveSurfaces": [
      "security",
      "auth",
      "data",
      "infra",
      "billing"
    ],
    "councilDomainThreshold": 3,
    "bilateralDomainThreshold": 2,
    "councilOnPublicContract": true,
    "councilOnMigration": true,
    "maxReworkRounds": 2,
    "councilHelpers": [
      "risk-scout",
      "implementation-strategist",
      "testability-scout",
      "docs-impact-scout"
    ],
    "discoveryHelpers": [
      "requirements-scout",
      "architecture-scout"
    ],
    "councilSeats": [
      {
        "role": "agentflow:architect",
        "focus": "architecture and system boundaries",
        "required": true
      },
      {
        "role": "agentflow:developer",
        "focus": "implementation feasibility",
        "required": true
      },
      {
        "role": "agentflow:tester",
        "focus": "testability and failure evidence",
        "required": true
      },
      {
        "role": "agentflow:reviewer",
        "focus": "risk and maintainability",
        "required": true
      }
    ],
    "fallbackModes": [
      "sequential",
      "manual"
    ],
    "maxDelegates": 4,
    "maxDepth": 1,
    "maxIterations": 3
  },
  "extensions": {
    "enabledPacks": []
  },
  "delivery": {
    "source": {
      "kind": "local-preview"
    },
    "candidate": {
      "inputs": [
        "src/App.vue",
        "src/components/AppNavigation.vue",
        "src/config/categories.js",
        "src/config/index.js",
        "src/config/interactionTypes.js",
        "src/firebase/index.js",
        "src/main.js",
        "src/models/Map.js",
        "src/models/Stakeholder.js",
        "src/models/StakeholderMap.js",
        "src/router/index.js",
        "src/services/aiService.js",
        "src/services/authService.js",
        "src/services/documentService.js",
        "src/services/index.js",
        "src/services/interactionService.js",
        "src/services/localStorageService.js",
        "src/services/mapService.js",
        "src/services/settingsService.js",
        "src/services/stakeholderService.js",
        "src/stores/notificationStore.js",
        "src/stores/stakeholderStore.js",
        "src/styles/main.css",
        "src/utils/dateUtils.js",
        "src/views/AdminSettings.vue",
        "src/views/Dashboard.vue",
        "src/views/Home.vue",
        "src/views/Login.vue",
        "src/views/NotFound.vue",
        "src/views/Settings.vue",
        "src/views/StakeholderDetail.vue",
        "src/views/StakeholderMap.vue"
      ]
    },
    "checks": {
      "starter": {
        "id": "starter",
        "criterionId": "starter",
        "executable": "npm",
        "args": [
          "test"
        ],
        "assertions": [
          "starter-criterion \u2014 replace with a real assertion from your test output"
        ],
        "timeoutMs": 300000,
        "format": "exit-code",
        "inheritEnv": [
          "APPDATA",
          "HOME",
          "LOCALAPPDATA",
          "MISE_CACHE_DIR",
          "MISE_GLOBAL_CONFIG_FILE",
          "MISE_SHELL",
          "MISE_STATE_DIR",
          "PYENV_VIRTUALENV_DISABLE_PROMPT",
          "USERPROFILE"
        ]
      }
    },
    "contracts": {
      "product-manager": "agentflow-acceptance.json"
    }
  },
  "gateNotifications": {
    "hookUrl": null
  },
  "executionDistribution": {
    "profile": "subscription-balanced-v1",
    "profileDigest": "ee486327708eb3de6b1cb67c825358af8679d9e0d9a8b6ca0164f14c1cfe8fcc",
    "overrides": {}
  }
}

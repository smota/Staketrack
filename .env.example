# StakeTrack Environment Example (NON-SENSITIVE VALUES)
# Copy this file to .env.development, .env.staging, or .env.production
# This file contains non-sensitive values that can be committed to Git

# Application Configuration
NODE_ENV=development
APP_VERSION=1.0.0
APP_ENVIRONMENT=DEVELOPMENT
BASE_URL=/

# Firebase Configuration (NON-SENSITIVE)
APP_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
APP_FIREBASE_PROJECT_ID=your-project-id
APP_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
APP_FIREBASE_FUNCTIONS_REGION=europe-west1

# Feature Flags
APP_ENABLE_ANALYTICS=false
APP_AI_ENABLED=true
APP_USE_EMULATORS=true

# Emulator Configuration (for development)
APP_EMULATOR_AUTH_PORT=9099
APP_EMULATOR_FIRESTORE_PORT=8080
APP_EMULATOR_FUNCTIONS_PORT=5001
APP_EMULATOR_STORAGE_PORT=9199

# CORS Configuration
APP_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# Rate Limits
APP_RATE_LIMIT_API_PER_MINUTE=60
APP_RATE_LIMIT_API_PER_HOUR=300
APP_RATE_LIMIT_API_PER_DAY=1000
APP_RATE_LIMIT_AI_PER_MINUTE=5
APP_RATE_LIMIT_AI_PER_DAY=50

# API Configuration
APP_API_BASE_URL=http://localhost:5001

# AI Configuration (Non-sensitive parts only)
APP_AI_MODEL=gemini-1.5-pro
APP_AI_WEEKLY_LIMIT=10

# Development Settings (Emulator ports)
APP_EMULATOR_AUTH_PORT=9099
APP_EMULATOR_FIRESTORE_PORT=8080
APP_EMULATOR_FUNCTIONS_PORT=5001
APP_EMULATOR_STORAGE_PORT=9199

# Additional Configuration
APP_ENABLE_CONFIG_VALIDATION=true
APP_DEBUG_LOCAL_STORAGE=false
APP_USE_LOCAL_STORAGE=false
APP_ENABLE_AI_RECOMMENDATIONS=true
APP_ENABLE_SHARING=true
APP_ENABLE_TEMPLATES=true 
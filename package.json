{
  "name": "staketrack",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "vue-cli-service serve --mode development",
    "serve": "vue-cli-service serve --mode development",
    "build": "vue-cli-service build --mode production",
    "build:dev": "vue-cli-service build --mode development",
    "build:staging": "vue-cli-service build --mode staging",
    "build:prod": "vue-cli-service build --mode production",
    "lint": "vue-cli-service lint",
    "test:unit": "vue-cli-service test:unit",
    "test:e2e": "playwright test",
    "test": "npm run test:unit && npm run test:e2e",
    "prepare": "husky install",
    "firebase:emulators": "firebase emulators:start",
    "firebase:emulators:dev": "firebase emulators:start --config firebase.development.json",
    "dev:emulate": "firebase emulators:start --config firebase.development.json",
    "firebase:deploy:staging": "firebase deploy --only hosting:staging",
    "firebase:deploy:prod": "firebase deploy --only hosting:production",
    "firebase:deploy:functions:staging": "firebase deploy --only functions -P staging",
    "firebase:deploy:functions:prod": "firebase deploy --only functions -P production",
    "firebase:test-config": "node scripts/test-config-function.js",
    "firebase:update-config:staging": "node scripts/update-firebase-config.js --env=staging",
    "firebase:setup": "node scripts/firebase-setup.js",
    "firebase:deploy": "node scripts/firebase-deploy.js",
    "deploy:dev": "node scripts/firebase-deploy.js --env=DEV --option=hosting",
    "deploy:prod": "node scripts/firebase-deploy.js --env=PRD --option=hosting",
    "deploy:rules:dev": "node scripts/firebase-deploy.js --env=DEV --option=rules",
    "deploy:rules:prod": "node scripts/firebase-deploy.js --env=PRD --option=rules",
    "deploy:all:dev": "node scripts/firebase-deploy.js --env=DEV --option=all",
    "deploy:all:prod": "node scripts/firebase-deploy.js --env=PRD --option=all",
    "deploy:staging": "node scripts/deploy-staging.js",
    "emulators": "firebase emulators:start"
  },
  "dependencies": {
    "@mdi/font": "^7.3.67",
    "@opentelemetry/api": "^1.9.0",
    "@opentelemetry/api-logs": "^0.200.0",
    "@opentelemetry/api-metrics": "^0.33.0",
    "@opentelemetry/context-zone": "^2.0.0",
    "@opentelemetry/exporter-metrics-otlp-http": "^0.200.0",
    "@opentelemetry/exporter-trace-otlp-http": "^0.200.0",
    "@opentelemetry/instrumentation": "^0.200.0",
    "@opentelemetry/instrumentation-document-load": "^0.44.1",
    "@opentelemetry/instrumentation-fetch": "^0.200.0",
    "@opentelemetry/resources": "^2.0.0",
    "@opentelemetry/sdk-logs": "^0.200.0",
    "@opentelemetry/sdk-metrics": "^2.0.0",
    "@opentelemetry/sdk-trace-base": "^2.0.0",
    "@opentelemetry/sdk-trace-web": "^2.0.0",
    "@opentelemetry/semantic-conventions": "^1.30.0",
    "core-js": "^3.8.3",
    "dotenv": "^16.4.5",
    "firebase": "^10.1.0",
    "vue": "^3.2.13",
    "vue-router": "^4.0.3",
    "vuetify": "^3.4.19"
  },
  "devDependencies": {
    "@babel/core": "^7.12.16",
    "@babel/eslint-parser": "^7.12.16",
    "@babel/plugin-syntax-jsx": "^7.25.9",
    "@babel/plugin-transform-runtime": "^7.26.10",
    "@babel/preset-react": "^7.26.3",
    "@playwright/test": "^1.40.1",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@vue/cli-plugin-babel": "~5.0.0",
    "@vue/cli-plugin-eslint": "~5.0.0",
    "@vue/cli-plugin-router": "~5.0.0",
    "@vue/cli-plugin-unit-jest": "~5.0.0",
    "@vue/cli-service": "~5.0.0",
    "@vue/test-utils": "^2.0.0-0",
    "@vue/vue3-jest": "^27.0.0-alpha.1",
    "axios": "^1.8.4",
    "babel-jest": "^27.0.6",
    "cross-env": "^7.0.3",
    "eslint": "^7.32.0",
    "eslint-plugin-vue": "^8.0.3",
    "firebase-admin": "^13.2.0",
    "firebase-tools": "^13.0.2",
    "flush-promises": "^1.0.2",
    "husky": "^8.0.3",
    "jest": "^27.0.5",
    "lint-staged": "^15.2.0",
    "node-fetch": "^3.3.2",
    "sass": "^1.32.7",
    "sass-loader": "^12.0.0",
    "typescript": "^5.3.3",
    "undici": "^7.10.0"
  },
  "eslintConfig": {
    "root": true,
    "env": {
      "node": true
    },
    "extends": [
      "plugin:vue/vue3-essential",
      "eslint:recommended"
    ],
    "parserOptions": {
      "parser": "@babel/eslint-parser"
    },
    "rules": {},
    "overrides": [
      {
        "files": [
          "**/__tests__/*.{j,t}s?(x)",
          "**/tests/unit/**/*.spec.{j,t}s?(x)"
        ],
        "env": {
          "jest": true
        }
      }
    ]
  },
  "browserslist": [
    "> 1%",
    "last 2 versions",
    "not dead",
    "not ie 11"
  ],
  "lint-staged": {
    "*.{js,jsx,vue}": "eslint --fix"
  }
}

# StakeTrack Development Environment Configuration

# Application Configuration
NODE_ENV=development
VUE_APP_VERSION=1.0.0
VUE_APP_ENVIRONMENT=DEV
BASE_URL=/

# Feature Flags
VUE_APP_ENABLE_ANALYTICS=false
VUE_APP_AI_ENABLED=true

# API Configuration
VUE_APP_API_BASE_URL=http://localhost:5001

# Firebase Configuration for Development (Emulators)
# NOTE: Sensitive values (API keys, app IDs, etc.) should be stored in .env.development.local
# For emulator use, these should match your project values even when using emulators
VUE_APP_FIREBASE_AUTH_DOMAIN=staketrack-dev.firebaseapp.com
VUE_APP_FIREBASE_PROJECT_ID=staketrack-dev
VUE_APP_FIREBASE_STORAGE_BUCKET=staketrack-dev.appspot.com
VUE_APP_FIREBASE_FUNCTIONS_REGION=europe-west1

# AI Configuration

VUE_APP_AI_MODEL=gemini-1.5-pro
VUE_APP_AI_WEEKLY_LIMIT=10 

# Development-specific Settings
VUE_APP_USE_EMULATORS=true
VUE_APP_EMULATOR_AUTH_PORT=9099
VUE_APP_EMULATOR_FIRESTORE_PORT=8080
VUE_APP_EMULATOR_FUNCTIONS_PORT=5001
VUE_APP_EMULATOR_STORAGE_PORT=9199 
# Example local environment file
# Copy this file to .env.development.local, .env.staging.local, or .env.production.local
# and fill in the appropriate values

# StakeTrack Local Environment Template
# Copy this file to .env.development.local or .env.production.local and replace the placeholder values
# with your actual API keys and secrets

# Application Configuration
NODE_ENV=development
APP_VERSION=1.0.0
APP_ENVIRONMENT=LOCAL

# Feature Flags
APP_USE_EMULATORS=true
APP_ENABLE_ANALYTICS=false

# API Configuration
APP_API_BASE_URL=http://localhost:5001

# Firebase Configuration
# Get these values from your Firebase Console
APP_FIREBASE_API_KEY=your-firebase-api-key
APP_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
APP_FIREBASE_PROJECT_ID=your-project-id
APP_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
APP_FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
APP_FIREBASE_APP_ID=your-firebase-app-id
APP_FIREBASE_MEASUREMENT_ID=your-firebase-measurement-id

# AI Configuration
APP_AI_ENABLED=true
APP_AI_MODEL=gemini-1.5-pro
APP_AI_WEEKLY_LIMIT=10

# Development Settings
# Enable emulators for local development
APP_USE_EMULATORS=true

# IMPORTANT: Never commit .env.*.local files to version control
# These files should be in your .gitignore 
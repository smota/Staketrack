# Example local environment file
# Copy this file to .env.development.local, .env.staging.local, or .env.production.local
# and fill in the appropriate values

# StakeTrack Environment Configuration Template
# Copy this file to .env.[environment].local where [environment] is:
#   - development
#   - staging
#   - production
# Use .env.[environment].local for sensitive values that should never be committed to version control

# SENSITIVE CONFIGURATION ONLY
# This file should contain ONLY sensitive configuration values
# Non-sensitive values should be placed in .env.[environment] files

# Application Configuration
NODE_ENV=development
VUE_APP_VERSION=1.0.0
VUE_APP_ENVIRONMENT=DEVELOPMENT
BASE_URL=/

# Feature Flags - all use the same pattern (enabled when value is 'true')
VUE_APP_USE_EMULATORS=true
VUE_APP_ENABLE_ANALYTICS=false
VUE_APP_AI_ENABLED=true
VUE_APP_ENABLE_CONFIG_VALIDATION=true
VUE_APP_DEBUG_LOCAL_STORAGE=false
VUE_APP_USE_LOCAL_STORAGE=false
VUE_APP_ENABLE_AI_RECOMMENDATIONS=true
VUE_APP_ENABLE_SHARING=true
VUE_APP_ENABLE_TEMPLATES=true

# CORS Configuration
VUE_APP_CORS_ALLOWED_ORIGINS=http://localhost:8080,http://localhost:3000

# Rate Limits
VUE_APP_RATE_LIMIT_API_PER_MINUTE=60
VUE_APP_RATE_LIMIT_API_PER_HOUR=300
VUE_APP_RATE_LIMIT_API_PER_DAY=1000
VUE_APP_RATE_LIMIT_AI_PER_MINUTE=5
VUE_APP_RATE_LIMIT_AI_PER_DAY=50

# API Configuration
VUE_APP_API_BASE_URL=http://localhost:5001

# Firebase Configuration - SENSITIVE VALUES ONLY
# Get these values from your Firebase Console
# These should be placed in .env.[environment].local files
VUE_APP_FIREBASE_API_KEY=your-firebase-api-key
VUE_APP_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VUE_APP_FIREBASE_PROJECT_ID=your-project-id
VUE_APP_FIREBASE_STORAGE_BUCKET=your-project-id.appspot.com
VUE_APP_FIREBASE_MESSAGING_SENDER_ID=your-firebase-messaging-sender-id
VUE_APP_FIREBASE_VUE_APP_ID=your-firebase-app-id
VUE_APP_FIREBASE_MEASUREMENT_ID=your-firebase-measurement-id
VUE_APP_FIREBASE_FUNCTIONS_REGION=europe-west1

# AI Configuration
VUE_APP_AI_MODEL=gemini-1.5-pro
VUE_APP_AI_WEEKLY_LIMIT=10

# Firebase Functions Configuration
# These variables are used by Firebase Functions
FUNCTION_MEMORY=256MiB
FUNCTION_MAX_INSTANCES=10

# Development Settings
# Enable emulators for local development
VUE_APP_EMULATOR_AUTH_PORT=9099
VUE_APP_EMULATOR_FIRESTORE_PORT=8080
VUE_APP_EMULATOR_FUNCTIONS_PORT=5001
VUE_APP_EMULATOR_STORAGE_PORT=9199

# AI API Keys (if needed)
ANTHROPIC_API_KEY=your-anthropic-api-key

# IMPORTANT: Never commit .env.*.local files to version control
# These files should be in your .gitignore 

